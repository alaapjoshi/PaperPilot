# Copy this file to .env.local and put in your own Gemini API key.
# Get a key at https://aistudio.google.com/apikey. Never commit .env.local.
GEMINI_API_KEY=your-gemini-api-key-here

# Optional: which Gemini model scans the drawing (default: gemini-flash-lite-latest).
# GEMINI_MODEL=gemini-flash-lite-latest
